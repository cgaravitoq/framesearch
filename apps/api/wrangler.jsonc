{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "framesearch",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "SEARCH_LOG": true
  },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/frames/*"]
  },
  "containers": [
    {
      "class_name": "EmbedderContainer",
      "image": "../embedder/Dockerfile",
      "instance_type": "basic",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EMBEDDER",
        "class_name": "EmbedderContainer"
      }
    ]
  },
  "exports": {
    "EmbedderContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "FRAMES",
      "bucket_name": "framesearch"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "framesearch",
      "database_id": "3b9b303a-b586-4f8e-9158-7950c34b8802",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SEARCH_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
