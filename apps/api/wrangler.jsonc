{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "framesearch-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/frames/*"]
  },
  "r2_buckets": [
    {
      "binding": "FRAMES",
      "bucket_name": "framesearch-staging"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "framesearch-staging",
      "database_id": "9e1efc80-9307-4cf4-9a82-faf8398787ad",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SEARCH_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
