{
  "name": "framesearch",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "typecheck": "TURBO_TELEMETRY_DISABLED=1 turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "TURBO_TELEMETRY_DISABLED=1 turbo run test",
    "framesearch": "bun run --cwd apps/cli framesearch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/bun": "1.4.4",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
